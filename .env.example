# ============================================================
# AURORA COMMERCE — the only files you edit before Vercel
# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables
# ============================================================

# Public site identity
NEXT_PUBLIC_STORE_NAME=Aurora
NEXT_PUBLIC_STORE_TAGLINE=A company that never sleeps.
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=owner@example.com
NEXT_PUBLIC_OWNER_NAME=Legal Owner

# Demo mode: set to "true" to allow mock checkout without Stripe keys
NEXT_PUBLIC_DEMO_MODE=true

# Stripe (leave blank to stay in demo mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: comma-separated emails that skip paywall (owner / testers)
UNLOCK_EMAILS=

# Feature flags
NEXT_PUBLIC_SHOW_AGENT_TOWER=true
NEXT_PUBLIC_CURRENCY=usd
